---
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['经验贴', '/experiences/'],
  ['保研流程', '/guide/'],
  ['资料与工具', '/resources/'],
  ['投稿', '/submit/'],
  ['关于', '/about/'],
] as const;
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const hrefFor = (path: string) => `${base}${path}`;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={hrefFor('/')}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" focusable="false">
          <path d="M7 8.5c4.1-.9 7.2-.3 9 1.6v14.2c-1.8-1.9-4.9-2.5-9-1.6V8.5Z" />
          <path d="M25 8.5c-4.1-.9-7.2-.3-9 1.6v14.2c1.8-1.9 4.9-2.5 9-1.6V8.5Z" />
          <path class="brand-sprout" d="M21.8 6.2c-1.8.1-3.2.8-4.2 2.2 1.9.2 3.4-.5 4.2-2.2Z" />
        </svg>
      </span>
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="主导航">
      <a class:list={{ active: currentPath === '/' }} href={hrefFor('/')}>首页</a>
      {links.map(([label, path]) => (
        <a class:list={{ active: currentPath.startsWith(path) }} href={hrefFor(path)}>{label}</a>
      ))}
    </nav>
  </div>
</header>

