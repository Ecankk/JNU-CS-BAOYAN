---
interface Props {
  currentPage: number;
  totalPages: number;
  pathPrefix: string;
}

const { currentPage, totalPages: pageCount, pathPrefix } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hrefFor = (page: number) => `${base}${page === 1 ? pathPrefix : `${pathPrefix}page/${page}/`}`;
---
{pageCount > 1 && (
  <nav class="pagination" aria-label="文章分页">
    <span class="pagination-label">共 {pageCount} 页</span>
    <div class="pagination-links">
      {Array.from({ length: pageCount }, (_, index) => index + 1).map((page) => (
        <a class:list={{ active: currentPage === page }} href={hrefFor(page)} aria-current={currentPage === page ? 'page' : undefined}>
          {page}
        </a>
      ))}
    </div>
  </nav>
)}
