---
import { Image } from 'astro:assets';
import type { ExperienceEntry } from '../lib/experiences';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import defaultCover from '../assets/default-cover.svg';

interface Props {
  entry: ExperienceEntry;
}
const { entry } = Astro.props;
const data = entry.data;
const cover = data.cover ?? defaultCover;
const coverAlt = data.coverAlt ?? `${data.title}封面`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={data.title} description={data.summary} />
  </head>
  <body>
    <Header />
    <main class="article-shell">
      <a class="back-link" href={`${base}/experiences/`}>← 返回经验贴</a>
      <article class="article">
        <Image class="article-cover" src={cover} alt={coverAlt} width={1200} height={675} />
        <header class="article-header">
          <p class="eyebrow">{data.applicationYear} · {data.author}</p>
          <h1>{data.title}</h1>
          {data.summary && <p class="article-summary">{data.summary}</p>}
          <div class="article-meta">
            {data.publishedAt && <span>发布于 <FormattedDate date={data.publishedAt} /></span>}
            {data.updatedAt && <span>更新于 <FormattedDate date={data.updatedAt} /></span>}
            {data.finalDestination && <span>最终去向：{data.finalDestination}</span>}
          </div>
        </header>
        <div class="prose"><slot /></div>
      </article>
      <nav class="article-end-nav" aria-label="文章导航">
        <a href={`${base}/experiences/${data.applicationYear}/`}>浏览 {data.applicationYear} 年经验贴</a>
        <a href={`${base}/experiences/`}>查看全部经验贴</a>
      </nav>
    </main>
    <Footer />
  </body>
</html>

